    def __init__(self):
        self.keyboard = Controller()
        # 定義按鍵庫參照
        self.locales = {
            "NTE": {
                    60: "z", 61: "shift+z", 62: "x", 63: "shift+x", 64: "c",
                65: "v", 66: "shift+v", 67: "b", 68: "shift+b", 69: "n",
                70: "shift+n", 71: "m", 72: "a", 73: "shift+a"
            }
            "Genhin":{ ... }
            "NKrein": { ... }
        }
        self.current_registry = self.locales["NTE"]

        #按鍵參照語系
    def set_locale(self, lang_name):
        """ 切換目前使用的語言映射表 """
        if lang_name in self.locales:
            self.current_registry = self.locales[lang_name]
            print(f"[Bridge] 已切換按鍵映射至：{lang_name}")
        else:
            print(f"[Bridge] 找不到語系 {lang_name}，維持原設定")

