   def generate_script(self, data, filename):
        # 導出可執行的 Python 腳本
        os.makedirs("exports", exist_ok=True)
        out_path = f"exports/{filename}.py"
        with open(out_path, "w", encoding="utf-8") as f:
            f.write(f"import time\nfrom pynput.keyboard import Controller, Key\n")
            f.write(f"DATA = {json.dumps(data['notes'])}\nBPM = {data['bpm']}\n")
            f.write("kb = Controller()\ndef play():\n    time.sleep(3)\n")
            f.write("    for n in DATA:\n        # 執行邏輯...\n        pass\nplay()")
        return out_path



---
    def __init__(self):
        self.keyboard = Controller()
        # 定義語系對照
        self.locales = {
            "繁體中文": { ... }
            "English":{ ... }
            "日本語": { ... }
        }
        self.current_registry = self.locales["繁體中文"]

        # 語言對照表 (i18n)
        self.text_data = {
            "繁體中文": {"select": "選擇樂譜", "start": "開始彈奏", "lang": "語言設定", "bpm": "播放速度 (BPM)", "semi": "半音偏移 (Key)"},
            "English": {"select": "Select XML", "start": "Start Playing", "lang": "Language", "bpm": "Tempo (BPM)", "semi": "Semitone Offset"}
        }

        self.setup_ui()

    def setup_ui(self):
        # --- 語言切換區 ---
        lang_frame = ttk.LabelFrame(self.root, text="Settings")
        lang_frame.pack(fill="x", padx=20, pady=10)
        
        ttk.Label(lang_frame, text="Language:").pack(side="left", padx=5)
        lang_menu = ttk.Combobox(lang_frame, textvariable=self.lang_var, values=list(self.text_data.keys()), state="readonly")
        lang_menu.pack(side="left", padx=5, pady=5)
        lang_menu.bind("<<ComboboxSelected>>", self.update_language)

